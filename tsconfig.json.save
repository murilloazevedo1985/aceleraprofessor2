{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-jsx",  // Importante: usa o novo JSX transform
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "types": ["node", "react", "react-dom"]  // Adicione esta linha
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules"]
}

find . -name "APP.tsx" -o -name "App.tsx" 2>/dev/null
find . -name "APP.tsx" -o -name "App.tsx" 2>/dev/null
code tsconfig.json
# Instalar React e tipos
npm install react react-dom
npm install --save-dev typescript @types/react @types/react-dom @types/n
